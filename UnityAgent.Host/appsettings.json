{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
    }
  },

  "Agent": {
    "Mode": "Explain",
    "MaximumContextTokens": 8192,
    "MaximumToolSteps": 8
  },

  "LocalModel": {
    "ServerUrl": "http://127.0.0.1:1234"
  },

  "Workspace": {
    "ProjectPath": "C:\\_DiskE\\Projects\\_Programs\\PCApps\\UnityAgent"
  },

  "Rider": {
    "Endpoint": "http://127.0.0.1:64482/stream"
  },

  "Storage": {
    "UnusedProjectCacheDays": 30,
    "TemporaryDataHours": 24,
    "MaximumCacheSizeMb": 2048,
    "PersistChats": false
  }
}
